# Copy to .streamlit/secrets.toml (never commit the real file).

# Token for the researcher panel: open the app at  ?admin=<this value>
admin_token = "change-me-to-a-long-random-string"

# Optional Google Sheets backend. Without this block responses go to data/responses.csv,
# which is wiped whenever Streamlit Cloud restarts the container.
# sheet_key = "the-id-between-/d/-and-/edit-in-the-sheet-url"
# worksheet_name = "responses"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
