# Copy to .streamlit/secrets.toml for local runs (never commit the real file), or
# paste the same content into Streamlit Cloud -> Settings -> Secrets.

# Token for the researcher panel: open the app at  ?admin=<this value>
admin_token = "change-me-to-a-long-random-string"

# --- Storage -----------------------------------------------------------------
# Supabase is used when both of these are set. This is the setup for a real run.
# supabase_url = "https://<project-ref>.supabase.co"
# supabase_key = "<service_role key>"

# Google Sheets is used if Supabase is not configured.
# sheet_key = "the-id-between-/d/-and-/edit-in-the-sheet-url"
# worksheet_name = "responses"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"

# With neither configured, responses go to data/responses.csv, which Streamlit
# Cloud wipes on every restart. Development only.
# responses_csv_path = "/mount/data/responses.csv"
